# Contoh Template Konfigurasi Environment (.env)
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi server Anda

# Database Driver: 'sqlite' atau 'mysql'
DB_DRIVER=sqlite

# Konfigurasi MySQL (hanya jika DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sia_mahasiswa
DB_USER=root
DB_PASS=

# App Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
